{
  "name": "ccjk-provider-api",
  "version": "1.0.0",
  "description": "CCJK Provider Registry API - Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "db:create": "wrangler d1 create ccjk-providers",
    "db:init": "wrangler d1 execute ccjk-providers --file=./schema.sql",
    "db:init:prod": "wrangler d1 execute ccjk-providers --file=./schema.sql --env production",
    "db:query": "wrangler d1 execute ccjk-providers --command",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "typescript": "^5.3.0",
    "wrangler": "^3.0.0"
  }
}
